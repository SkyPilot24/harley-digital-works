# Supabase public client values
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated HMAC secret for lead rate-limit fingerprints (server only, required in production)
LEAD_RATE_LIMIT_SECRET=

# Cloudflare Turnstile bot verification (default false for local dev and tests)
TURNSTILE_ENABLED=false
# Keep this build-time browser flag aligned with the server flag for form and chat.
VITE_TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Slack Command Centre & Webhook Configuration
LEAD_NOTIFICATIONS_ENABLED=false
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Optional dedicated per-channel webhooks (multiplexes through SLACK_WEBHOOK_URL if omitted)
SLACK_WEBHOOK_FOUNDER_COMMAND=
SLACK_WEBHOOK_NEW_LEADS=
SLACK_WEBHOOK_SALES=
SLACK_WEBHOOK_CUSTOMERS=
SLACK_WEBHOOK_OPERATIONS=
SLACK_WEBHOOK_FINANCE_ALERTS=
SLACK_WEBHOOK_SYSTEM_ALERTS=
SLACK_WEBHOOK_AUTOMATION_ALERTS=
SLACK_WEBHOOK_DEPLOYMENTS=

# Staff-only sending stays disabled until sender, quotas and monitoring are verified.
TRANSACTIONAL_EMAIL_ENABLED=false
RESEND_API_KEY=
TRANSACTIONAL_SENDER_EMAIL=

# IONOS Developer API (Domains & DNS management: publicprefix.secret)
IONOS_API_KEY=

# Google Maps Platform (Places, Geocoding, Static Maps - funded by monthly charity credits)
GOOGLE_MAPS_API_KEY=
