# Supabase public client values
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase values
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional dedicated HMAC secret for lead rate-limit fingerprints (server only)
LEAD_RATE_LIMIT_SECRET=

# Slack Command Centre & Webhook Configuration
LEAD_NOTIFICATIONS_ENABLED=false
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Optional dedicated per-channel webhooks (multiplexes through SLACK_WEBHOOK_URL if omitted)
SLACK_WEBHOOK_FOUNDER_COMMAND=
SLACK_WEBHOOK_NEW_LEADS=
SLACK_WEBHOOK_SALES=
SLACK_WEBHOOK_CUSTOMERS=
SLACK_WEBHOOK_OPERATIONS=
SLACK_WEBHOOK_FINANCE_ALERTS=
SLACK_WEBHOOK_SYSTEM_ALERTS=
SLACK_WEBHOOK_AUTOMATION_ALERTS=
SLACK_WEBHOOK_DEPLOYMENTS=

# Staff-only sending stays disabled until sender, quotas and monitoring are verified.
TRANSACTIONAL_EMAIL_ENABLED=false
RESEND_API_KEY=
TRANSACTIONAL_SENDER_EMAIL=
