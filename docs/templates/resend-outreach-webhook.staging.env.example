# RESEND OUTREACH WEBHOOK — STAGING OVERLAY ONLY
#
# This is a safe-to-commit template, not a real .env file.
# Apply values through the authorised staging configuration/secret store.
# Do not overwrite unrelated runtime variables and never commit real secrets.
#
# Target: isolated staging backend mfpnfxpgkfuqtedbcxvp
# Webhook activation remains disabled until the migration, route and staged
# acceptance checklist in docs/RESEND_OUTREACH_WEBHOOK_DEPLOYMENT.md are complete.

# Existing platform bindings: set these to the STAGING project only.
SUPABASE_URL=https://mfpnfxpgkfuqtedbcxvp.supabase.co
VITE_SUPABASE_URL=https://mfpnfxpgkfuqtedbcxvp.supabase.co
SUPABASE_PUBLISHABLE_KEY=__SET_STAGING_PUBLISHABLE_KEY__
VITE_SUPABASE_PUBLISHABLE_KEY=__MATCH_SUPABASE_PUBLISHABLE_KEY__

# Server secret: platform secret store only. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=__SET_STAGING_SERVER_SECRET__

# Inbound Resend webhook: keep disabled until an approved test window.
RESEND_WEBHOOK_ENABLED=false
RESEND_WEBHOOK_SIGNING_SECRET=__SET_STAGING_RESEND_SIGNING_SECRET_AS_SERVER_SECRET__

# Keep all outbound effects disabled during webhook setup and testing.
LEAD_NOTIFICATIONS_ENABLED=false
SLACK_NOTIFICATIONS_ENABLED=false
TRANSACTIONAL_EMAIL_ENABLED=false

# Deliberately excluded from this inbound-webhook overlay:
# RESEND_API_KEY
# TRANSACTIONAL_SENDER_EMAIL
# TRANSACTIONAL_SENDER_NAME
# PILOT_P01_TARGET_EMAIL
# Add them only under a separate approved outbound-email change.
