# RESEND OUTREACH WEBHOOK — PRODUCTION OVERLAY ONLY
#
# This is a safe-to-commit template, not a real .env file.
# Apply values only after staged acceptance and explicit founder release approval.
# Do not overwrite unrelated runtime variables and never commit real secrets.
#
# Target: production backend worzpzbutngugwzhlvtj
# Keep the inbound webhook disabled through deployment. Enable only during an
# authorised, monitored production acceptance window after the route and CRM
# migration are verified on the live target.

# Existing platform bindings: confirm these match the PRODUCTION project.
SUPABASE_URL=https://worzpzbutngugwzhlvtj.supabase.co
VITE_SUPABASE_URL=https://worzpzbutngugwzhlvtj.supabase.co
SUPABASE_PUBLISHABLE_KEY=__SET_PRODUCTION_PUBLISHABLE_KEY__
VITE_SUPABASE_PUBLISHABLE_KEY=__MATCH_SUPABASE_PUBLISHABLE_KEY__

# Server secret: platform secret store only. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=__SET_PRODUCTION_SERVER_SECRET__

# Inbound Resend webhook: disabled by default even in production.
RESEND_WEBHOOK_ENABLED=false
RESEND_WEBHOOK_SIGNING_SECRET=__SET_PRODUCTION_RESEND_SIGNING_SECRET_AS_SERVER_SECRET__

# This overlay does not alter existing lead/Slack/transactional-email settings.
# Do NOT set TRANSACTIONAL_EMAIL_ENABLED=true as part of this webhook release.
# Do NOT add RESEND_API_KEY, sender identity or prospect email values here.
# Outbound sending requires a separate scoped approval and deployment.
